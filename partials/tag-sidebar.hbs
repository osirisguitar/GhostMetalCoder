{{!-- Metal Coder: side navigation listing every public tag that has posts.
Included on the post listing pages (index.hbs, tag.hbs, author.hbs).
Pass current_tag=tag.slug to highlight the tag being viewed.
Sorted by number of posts, then alphabetically. Ghost 6 caps {{#get}} at 100
results, so at most the 100 most used tags are listed.
Below the desktop breakpoint, assets/js/tag-sidebar.js collapses the list to
two rows with a toggle (without JS the full list is shown). --}}
{{#get "tags" limit="100" filter="visibility:public" include="count.posts" order="count.posts desc, slug asc" as |sidebar_tags|}}
{{#if sidebar_tags}}
<aside class="tag-sidebar" aria-label="Topics">
    <div class="tag-sidebar-header">
        <h2 class="tag-sidebar-title">Topics</h2>
        <button class="tag-sidebar-toggle" type="button" aria-expanded="false" aria-controls="tag-sidebar-list" hidden>Show all</button>
    </div>
    <ul class="tag-sidebar-list" id="tag-sidebar-list">
        {{#foreach sidebar_tags}}
            {{#if count.posts}}
            <li>
                <a class="tag-sidebar-link{{#match slug ../../current_tag}} is-current{{/match}}" href="{{url}}"{{#match slug ../../current_tag}} aria-current="page"{{/match}}>
                    <span class="tag-sidebar-name">{{name}}</span>
                    <span class="tag-sidebar-count">{{count.posts}}</span>
                </a>
            </li>
            {{/if}}
        {{/foreach}}
    </ul>
</aside>
{{/if}}
{{/get}}
